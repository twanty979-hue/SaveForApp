{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "saveforapp",
  "keep_vars": true,
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npx opennextjs-cloudflare build"
  }
}
